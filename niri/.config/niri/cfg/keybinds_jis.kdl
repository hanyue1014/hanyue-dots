binds {

    // ─── Layout Controls ───
    Mod+Slash                           { set-column-width "-10%"; }
    Mod+Backslash                       { set-column-width "+10%"; }
    Mod+Shift+Minus                     { set-window-height "-10%"; }
    Mod+Shift+Equal                     { set-window-height "+10%"; }

}
